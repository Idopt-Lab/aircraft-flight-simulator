% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (deck);
\chainin (derv) [join=by ProcessHVA];
\chainin (ctx) [join=by ProcessHVA];
\chainin (asm) [join=by ProcessHVA];
\chainin (trim) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (trim);
\chainin (model) [join=by ProcessHVA];
\chainin (trim) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (trim);
\chainin (stab) [join=by ProcessHVA];
\chainin (perf) [join=by ProcessHVA];
\chainin (xport) [join=by ProcessHVA];
\chainin (tloop) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (tloop);
\chainin (sfun) [join=by ProcessHVA];
\chainin (tloop) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (tloop);
\chainin (fdm) [join=by ProcessHVA];
\chainin (bridge) [join=by ProcessHVA];
\chainin (view) [join=by ProcessHVA];
\end{pgfonlayer}
}

\begin{pgfonlayer}{data}
\path
% Horizontal edges
(deck) edge [DataLine] (deck-derv)
