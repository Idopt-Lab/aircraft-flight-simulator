(deck) edge [DataLine] (output_deck)
(ctx) edge [DataLine] (output_ctx)
(trim) edge [DataLine] (output_trim)
(tloop) edge [DataLine] (output_tloop)
(bridge) edge [DataLine] (output_bridge);
