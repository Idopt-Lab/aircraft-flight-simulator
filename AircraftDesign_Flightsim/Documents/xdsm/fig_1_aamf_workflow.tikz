(trim) edge [DataLine] (trim-perf)
(trim) edge [DataLine] (trim-xport)
(xport) edge [DataLine] (xport-tloop)
(xport) edge [DataLine] (xport-sfun)
(tloop) edge [DataLine] (tloop-sfun)
(sfun) edge [DataLine] (sfun-tloop)
(tloop) edge [DataLine] (tloop-fdm)
(fdm) edge [DataLine] (fdm-bridge)
(bridge) edge [DataLine] (bridge-view)
(derv) edge [DataLine] (right_output_derv)
(trim) edge [DataLine] (right_output_trim)
(stab) edge [DataLine] (right_output_stab)
(perf) edge [DataLine] (right_output_perf)
(view) edge [DataLine] (right_output_view)
% Vertical edges
(deck-derv) edge [DataLine] (derv)
(deck-ctx) edge [DataLine] (ctx)
(deck-asm) edge [DataLine] (asm)
(deck-perf) edge [DataLine] (perf)
(derv-ctx) edge [DataLine] (ctx)
(ctx-asm) edge [DataLine] (asm)
(ctx-model) edge [DataLine] (model)
(asm-trim) edge [DataLine] (trim)
(asm-model) edge [DataLine] (model)
(asm-xport) edge [DataLine] (xport)
(trim-model) edge [DataLine] (model)
(model-trim) edge [DataLine] (trim)
(trim-stab) edge [DataLine] (stab)
(trim-perf) edge [DataLine] (perf)
(trim-xport) edge [DataLine] (xport)
(xport-tloop) edge [DataLine] (tloop)
(xport-sfun) edge [DataLine] (sfun)
