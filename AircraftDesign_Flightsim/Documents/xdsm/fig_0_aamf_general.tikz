% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (deck);
\chainin (aeromod) [join=by ProcessHVA];
\chainin (cfg) [join=by ProcessHVA];
\chainin (trim) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (deck);
\chainin (propmod) [join=by ProcessHVA];
\chainin (cfg) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (trim);
\chainin (loads) [join=by ProcessHVA];
\chainin (trim) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (trim);
\chainin (perfpt) [join=by ProcessHVA];
\chainin (stab) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (stab);
\chainin (loads) [join=by ProcessHVA];
\chainin (stab) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (stab);
\chainin (field) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (field);
\chainin (loads) [join=by ProcessHVA];
\chainin (field) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (field);
\chainin (mission) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (mission);
\chainin (trim) [join=by ProcessHVA];
\chainin (mission) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (mission);
\chainin (xport) [join=by ProcessHVA];
\chainin (sim6) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (sim6);
\chainin (sfun) [join=by ProcessHVA];
\chainin (sim6) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (sfun);
\chainin (loads) [join=by ProcessHVA];
\chainin (sfun) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (sim6);
\chainin (viz) [join=by ProcessHVA];
\end{pgfonlayer}
}

\begin{pgfonlayer}{data}
