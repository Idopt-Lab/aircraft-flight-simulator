(loads-perfpt) edge [DataLine] (perfpt)
(perfpt-loads) edge [DataLine] (loads)
(loads-stab) edge [DataLine] (stab)
(stab-loads) edge [DataLine] (loads)
(loads-field) edge [DataLine] (field)
(field-loads) edge [DataLine] (loads)
(mission-trim) edge [DataLine] (trim)
(xport-sim6) edge [DataLine] (sim6)
