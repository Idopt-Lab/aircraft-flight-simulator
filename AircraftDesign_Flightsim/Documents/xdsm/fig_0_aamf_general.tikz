(viz) edge [DataLine] (right_output_viz)
% Vertical edges
(deck-aeromod) edge [DataLine] (aeromod)
(deck-propmod) edge [DataLine] (propmod)
(deck-cfg) edge [DataLine] (cfg)
(aeromod-cfg) edge [DataLine] (cfg)
(propmod-cfg) edge [DataLine] (cfg)
(cfg-trim) edge [DataLine] (trim)
(cfg-loads) edge [DataLine] (loads)
