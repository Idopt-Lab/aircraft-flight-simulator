\begin{tikzpicture}

\matrix[MatrixSetup]{
%Row 0
&
\node [DataIO] (output_cond) {$h,\ \text{ISA}$};&
\node [DataIO] (output_disk) {$\begin{array}{c}D,\ \eta_{FoM}, \\ J_{des},\ J_{0}\ \text{(fixed pitch)}\end{array}$};&
\node [DataIO] (output_aero) {$\begin{array}{c}\mathbf{a}\ \text{(Fig. 1)}, \\ \text{gear, flap}\end{array}$};&
\node [DataIO] (output_elec) {$Q_{max},\ N_{cmd},\ P_{max}$};&
\node [DataIO] (output_grav) {$m,\ \mathbf{r}_{cg}$};&
&
&
\\
%Row 1
\node [MDA] (call) {$\begin{array}{c}\text{1, 6: Trim solver} \\ \text{or S-function}\end{array}$};&
\node [DataInter] (call-cond) {$\mathbf{x},\ \mathbf{u}$};&
&
&
&
&
&
&
\\
%Row 2
&
\node [Function] (cond) {$\begin{array}{c}\text{2: Flight condition} \\ \text{and atmosphere}\end{array}$};&
\node [DataInter] (cond-disk) {$\begin{array}{c}V_{ax}=u,\ \rho \\ \text{(body-x, not } |V| )\end{array}$};&
\node [DataInter] (cond-aero) {$\begin{array}{c}\alpha,\beta,\bar q,M, \\ \hat p,\hat q,\hat r\end{array}$};&
\node [DataInter] (cond-elec) {$\rho,\ V_{ax}$};&
\node [DataInter] (cond-grav) {$\phi,\theta,\psi$};&
&
&
\\
%Row 3
&
&
\node [ImplicitFunction,stack] (disk) {$\begin{array}{c}\text{3: Propeller disk} \\ \texttt{X57PropModel} \\ \text{bisection}\end{array}$};&
\node [DataInter] (disk-aero) {$\begin{array}{c}(V_{slip}/V)^2 \rightarrow \text{blow} \\ T_{CM} \rightarrow T_c \rightarrow K_0,K_2\end{array}$};&
\node [DataInter] (disk-elec) {$T_{each},\ P_{ideal}$};&
&
&
&
\\
%Row 4
&
&
&
\node [Function] (aero) {$\begin{array}{c}\text{4: Aerodynamic} \\ \text{coefficients} \\ \texttt{X57Lookup}\end{array}$};&
&
&
\node [DataInter] (aero-sum) {$C_L,C_D,C_Y,C_l,C_m,C_n$};&
&
\node [DataIO] (right_output_aero) {$\text{envelope flags}$};\\
%Row 5
&
&
&
&
\node [Function,stack] (elec) {$\begin{array}{c}\text{4: Propulsive elements} \\ \texttt{X57ElectricPropulsor}\end{array}$};&
&
\node [DataInter] (elec-sum) {$\begin{array}{c}\mathbf{F}_T,\ \mathbf{M}_T, \\ P_{shaft},P_{elec}\end{array}$};&
&
\node [DataIO] (right_output_elec) {$P_{elec},\ I_{bus}$};\\
%Row 6
&
&
&
&
&
\node [Function] (grav) {$\begin{array}{c}\text{4: Gravity} \\ \texttt{GravityLoadSolver}\end{array}$};&
\node [DataInter] (grav-sum) {$\mathbf{W}_b$};&
&
\\
%Row 7
\node [DataInter] (sum-call) {$\begin{array}{c}\mathcal{R}=(\dot u,\dot w,\dot p,\dot q,\dot r) \\ \text{5 of 6}\end{array}$};&
&
&
&
&
&
\node [Function] (sum) {$\begin{array}{c}\text{5: Load assembly} \\ \text{and residual}\end{array}$};&
&
\node [DataIO] (right_output_sum) {$\begin{array}{c}\mathbf{F},\ \mathbf{M}\ \text{about cg}, \\ \dot m_{fuel}=0\end{array}$};\\
%Row 8
&
&
&
&
&
&
&
&
\\
};

% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (call);
\chainin (cond) [join=by ProcessHVA];
\chainin (disk) [join=by ProcessHVA];
\chainin (aero) [join=by ProcessHVA];
\chainin (sum) [join=by ProcessHVA];
\chainin (call) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (disk);
\chainin (elec) [join=by ProcessHVA];
\chainin (sum) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (cond);
\chainin (grav) [join=by ProcessHVA];
\chainin (sum) [join=by ProcessHVA];
\end{pgfonlayer}
}

\begin{pgfonlayer}{data}
\path
% Horizontal edges
(call) edge [DataLine] (call-cond)
(cond) edge [DataLine] (cond-disk)
(cond) edge [DataLine] (cond-aero)
(cond) edge [DataLine] (cond-elec)
(cond) edge [DataLine] (cond-grav)
(disk) edge [DataLine] (disk-aero)
(disk) edge [DataLine] (disk-elec)
(aero) edge [DataLine] (aero-sum)
(elec) edge [DataLine] (elec-sum)
(grav) edge [DataLine] (grav-sum)
(sum) edge [DataLine] (sum-call)
(sum) edge [DataLine] (right_output_sum)
(elec) edge [DataLine] (right_output_elec)
(aero) edge [DataLine] (right_output_aero)
% Vertical edges
(call-cond) edge [DataLine] (cond)
(cond-disk) edge [DataLine] (disk)
(cond-aero) edge [DataLine] (aero)
(cond-elec) edge [DataLine] (elec)
(cond-grav) edge [DataLine] (grav)
(disk-aero) edge [DataLine] (aero)
(disk-elec) edge [DataLine] (elec)
(aero-sum) edge [DataLine] (sum)
(elec-sum) edge [DataLine] (sum)
(grav-sum) edge [DataLine] (sum)
(sum-call) edge [DataLine] (call)
(cond) edge [DataLine] (output_cond)
(disk) edge [DataLine] (output_disk)
(aero) edge [DataLine] (output_aero)
(elec) edge [DataLine] (output_elec)
(grav) edge [DataLine] (output_grav);
\end{pgfonlayer}

\end{tikzpicture}
