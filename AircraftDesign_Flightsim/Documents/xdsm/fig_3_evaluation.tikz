% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (pt);
\chainin (stall) [join=by ProcessHVA];
\chainin (ld) [join=by ProcessHVA];
\chainin (pwr) [join=by ProcessHVA];
\chainin (env) [join=by ProcessHVA];
\chainin (vmc) [join=by ProcessHVA];
\chainin (rc) [join=by ProcessHVA];
\chainin (fld) [join=by ProcessHVA];
\chainin (cmp) [join=by ProcessHVA];
\chainin (ver) [join=by ProcessHVA];
\end{pgfonlayer}
}

\begin{pgfonlayer}{data}
\path
% Horizontal edges
(pt) edge [DataLine] (pt-stall)
(pt) edge [DataLine] (pt-ld)
(pt) edge [DataLine] (pt-pwr)
(pt) edge [DataLine] (pt-env)
(pt) edge [DataLine] (pt-vmc)
(pt) edge [DataLine] (pt-rc)
(pt) edge [DataLine] (pt-fld)
(stall) edge [DataLine] (stall-rc)
(stall) edge [DataLine] (stall-cmp)
(ld) edge [DataLine] (ld-cmp)
(pwr) edge [DataLine] (pwr-cmp)
(env) edge [DataLine] (env-cmp)
(vmc) edge [DataLine] (vmc-cmp)
(rc) edge [DataLine] (rc-cmp)
(fld) edge [DataLine] (fld-cmp)
(cmp) edge [DataLine] (cmp-ver)
(cmp) edge [DataLine] (right_output_cmp)
(ver) edge [DataLine] (right_output_ver)
% Vertical edges
(pt-stall) edge [DataLine] (stall)
(pt-ld) edge [DataLine] (ld)
(pt-pwr) edge [DataLine] (pwr)
(pt-env) edge [DataLine] (env)
(pt-vmc) edge [DataLine] (vmc)
(pt-rc) edge [DataLine] (rc)
(pt-fld) edge [DataLine] (fld)
(stall-rc) edge [DataLine] (rc)
(stall-cmp) edge [DataLine] (cmp)
(ld-cmp) edge [DataLine] (cmp)
(pwr-cmp) edge [DataLine] (cmp)
(env-cmp) edge [DataLine] (cmp)
(vmc-cmp) edge [DataLine] (cmp)
(rc-cmp) edge [DataLine] (cmp)
(fld-cmp) edge [DataLine] (cmp)
(cmp-ver) edge [DataLine] (ver)
(pt) edge [DataLine] (output_pt)
(stall) edge [DataLine] (output_stall)
(pwr) edge [DataLine] (output_pwr)
(vmc) edge [DataLine] (output_vmc)
(cmp) edge [DataLine] (output_cmp)
(ver) edge [DataLine] (output_ver);
\end{pgfonlayer}

\end{tikzpicture}
